{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/AUSTRALIAN-FOR-AIS/schemas/v0.1.0/annotation.schema.json",
  "x-project-schema-version": "0.1.0",
  "title": "Australian For AIs — Human Annotation",
  "description": "Schema for one independent human annotation of a Phase 2 pilot item.",
  "type": "object",
  "required": [
    "annotation_id",
    "example_id",
    "annotator_id",
    "literal_interpretation",
    "pragmatic_interpretations",
    "primary_pragmatic_interpretation",
    "humour_mechanisms",
    "social_valence",
    "hostility",
    "confidence",
    "ambiguity",
    "cultural_dependency",
    "context_required"
  ],
  "additionalProperties": false,
  "properties": {
    "annotation_id": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Stable identifier for this annotation record."},
    "example_id": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Pilot item identifier."},
    "annotator_id": {"type": "string", "pattern": "^annotator-[0-9a-f]{12}$", "description": "Locally generated pseudonymous annotator identifier. Names, email addresses, account handles, and other direct identifiers are not accepted by the Phase 2 browser workflow."},
    "literal_interpretation": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "pragmatic_interpretations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "primary_pragmatic_interpretation": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "humour_mechanisms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "One or more active taxonomy labels. 'unknown' is mutually exclusive with every specific mechanism.",
      "items": {"type": "string", "enum": ["understatement", "sarcasm", "irony", "deadpan", "affectionate_insult", "inverse_praise", "profanity_non_hostile", "discourse_marker", "self_deprecation", "absurdist_escalation", "relational_teasing", "tall_poppy_humour", "ambiguous_address", "literal", "unknown"]},
      "not": {
        "allOf": [
          {"contains": {"const": "unknown"}},
          {"minItems": 2}
        ]
      }
    },
    "social_valence": {"type": "string", "enum": ["friendly", "hostile", "neutral", "ambiguous", "unknown"]},
    "hostility": {"oneOf": [{"type": "boolean"}, {"type": "string", "enum": ["uncertain"]}]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "ambiguity": {"type": "boolean"},
    "cultural_dependency": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
    "context_required": {"type": "boolean"},
    "alternative_interpretations": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "annotation_notes": {"type": "string"},
    "australian_english_exposure": {"type": "string", "enum": ["low", "medium", "high", "unspecified"], "description": "Optional non-identifying self-report of familiarity with Australian English."}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pragmatic_interpretations": {"minItems": 2}
        }
      },
      "then": {
        "properties": {
          "ambiguity": {"const": true}
        }
      }
    }
  ]
}
